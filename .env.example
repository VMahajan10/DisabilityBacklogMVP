# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional tuning
IMAGING_RECENCY_MONTHS=12
STALE_RECORD_MONTHS=12
VERIFY_THRESHOLD=0.85
# Cheaper model for bulk work (page tagging, map summaries, synthetic note generation)
OPENAI_FAST_MODEL=gpt-4.1-mini
# Approximate USD per 1M tokens for cost reports - VERIFY against OpenAI's current pricing
MODEL_PRICES_PER_1M=gpt-4.1=2.00/8.00,gpt-4.1-mini=0.40/1.60,text-embedding-3-small=0.02/0
# Scale pipeline
OCR_MIN_CHARS=40
NEAR_DUP_JACCARD=0.9
MAP_BATCH_PAGES=20
LLM_WORKERS=8
LISTING_PAGES_PER_CRITERION=6
LISTING_MAX_PAGES=40
